# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=ai_bpi
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/ai_bpi
JWT_SECRET_KEY=your_super_secret_jwt_key_change_me_in_production

# CORS allowed origins (comma-separated list for production, e.g. https://app.nexora.ai, https://admin.nexora.ai)
CORS_ORIGINS=*

# Frontend (Vite) — set these when deploying to a real host
# Leave blank for local development (defaults to http://127.0.0.1:8000)
VITE_API_URL=http://your-backend-host:8000
VITE_WS_URL=ws://your-backend-host:8000/api/ws

# Optional: enable LLM-powered business explanations (uses Gemini free tier)
# GEMINI_API_KEY=your_gemini_api_key

# Optional: Email OTP Verification Provider Settings
# To enable free email OTP, you can use Resend (free 3,000 emails/mo) or Gmail SMTP:
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASSWORD=your_resend_api_key_or_app_password
# SMTP_FROM_EMAIL=auth@nexora-bpi.com

# Google Identity Services (Sign in with Google)
# GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

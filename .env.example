# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=ai_bpi
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/ai_bpi
JWT_SECRET_KEY=your_super_secret_jwt_key_change_me_in_production

# Optional: set this to enable LLM-powered business explanations
# GEMINI_API_KEY=your_gemini_api_key
